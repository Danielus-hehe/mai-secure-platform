<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Argon2id - implementare .NET pura, fara dependinte native -->
        <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />

        <!-- Client S3: acopera MinIO, Amazon S3, Cloudflare R2, Supabase Storage -->
        <PackageReference Include="AWSSDK.S3" Version="3.7.*" />

        <!-- ILogger in stratul de business, fara referinta la ASP.NET Core -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />

        <!-- LDAP v3 brut (LDAPS / StartTLS), portabil Windows + Linux. Alternativa
             System.DirectoryServices (ADSI) exista doar pe Windows, iar API-ul
             ruleaza in container Linux. -->
        <PackageReference Include="System.DirectoryServices.Protocols" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MAI.Domain\MAI.Domain.csproj" />
        <ProjectReference Include="..\MAI.DataAccessLayer\MAI.DataAccessLayer.csproj" />
    </ItemGroup>

</Project>