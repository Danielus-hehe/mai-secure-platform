# ─────────────────────────────────────────────────────────────────────────────
# SGDM - nginx: TLS, frontend static, reverse proxy spre API
#
# ȘABLON. La pornire, scriptul oficial al imaginii (envsubst) înlocuiește
# variabilele SGDM_* și scrie rezultatul în /etc/nginx/conf.d/default.conf.
# Variabilele nginx ($host, $uri, $remote_addr) rămân neatinse, datorită
# filtrului NGINX_ENVSUBST_FILTER=^SGDM_ din Dockerfile.
#
#   SGDM_SERVER_NAME    numele DNS din certificat (ex. sgdm.local)
#   SGDM_PUBLIC_ORIGIN  adresa completă, cu port dacă nu e 443
#   SGDM_API_UPSTREAM   host:port al API-ului în rețeaua Docker
#   SGDM_DNS_RESOLVER   DNS-ul intern Docker (127.0.0.11)
# ─────────────────────────────────────────────────────────────────────────────

# Versiunea nginx nu apare nici în antetul Server, nici în paginile de eroare:
# nu schimbă nimic pentru un atacator hotărât, dar nu îi mai scurtează căutarea.
server_tokens off;

# ═════════════════════════════════════════════════════════════════════════════
# HTTP (80): doar redirecționare spre HTTPS și sonda de sănătate
# ═════════════════════════════════════════════════════════════════════════════
server {
    listen 80;
    server_name _;

    # Healthcheck-ul Docker. Pe HTTP intenționat: sonda nu trebuie să depindă
    # de validarea certificatului, iar răspunsul nu conține nimic.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Destinația e fixă (SGDM_PUBLIC_ORIGIN), nu construită din antetul Host.
    # Cu $host, oricine trimite „Host: atacator.example” primește un 301 spre
    # domeniul lui - o redirecționare deschisă, gratis, pe numele instituției.
    location / {
        return 301 ${SGDM_PUBLIC_ORIGIN}$request_uri;
    }
}

# ═════════════════════════════════════════════════════════════════════════════
# HTTPS (443)
# ═════════════════════════════════════════════════════════════════════════════
server {
    listen 443 ssl;
    http2 on;
    server_name ${SGDM_SERVER_NAME};

    # ── TLS ──────────────────────────────────────────────────────────────────
    # Certificatul vine din ./certs/tls pe gazdă. Dacă lipsește, 15-sgdm-tls.sh
    # generează unul autosemnat la prima pornire (doar pentru demonstrație).
    ssl_certificate     /etc/nginx/tls/tls.crt;
    ssl_certificate_key /etc/nginx/tls/tls.key;

    # Profilul „intermediate” Mozilla: TLS 1.2 + 1.3, doar suite AEAD cu
    # schimb de chei efemer (forward secrecy). TLS 1.0/1.1 sunt retrase
    # (RFC 8996); orice browser din ultimii ~8 ani negociază 1.2 sau 1.3.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SGDM_TLS:10m;
    # Tichetele de sesiune se cifrează cu o cheie care stă în memoria nginx
    # cât rulează procesul; cine o obține decriptează retroactiv sesiunile
    # reluate. Dezactivate, forward secrecy rămâne întreagă.
    ssl_session_tickets off;

    # ── Limite ───────────────────────────────────────────────────────────────
    # Prima barieră, înaintea API-ului: 50 MB fișier + 1 MB plic multipart
    # (UploadLimits.MaxRequestBytes) + o marjă. Plafonul real rămâne în API;
    # aici doar oprim o cerere de 2 GB înainte să ocupe o conexiune spre el.
    client_max_body_size 52m;

    # ── Upstream prin variabilă ──────────────────────────────────────────────
    # Cu „proxy_pass http://api:8080;” direct, nginx rezolvă numele O SINGURĂ
    # DATĂ, la pornire. Două probleme: (1) dacă API-ul nu e încă în rețea,
    # nginx refuză să pornească; (2) după o recreare a containerului api (IP
    # nou), nginx trimite în continuare la IP-ul vechi, până la restart.
    # Cu variabilă + resolver, numele se rezolvă la cerere, cu cache de 10 s.
    resolver ${SGDM_DNS_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;
    set $sgdm_api http://${SGDM_API_UPSTREAM};

    root /usr/share/nginx/html;

    # ── API ──────────────────────────────────────────────────────────────────
    location ^~ /api/ {
        # Fără URI după $sgdm_api: cererea ajunge la API cu calea originală
        # (/api/Transfers/...), exact ca în dezvoltare.
        proxy_pass $sgdm_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;

        # SUPRASCRIS, nu adăugat ($proxy_add_x_forwarded_for). Un client poate
        # trimite singur „X-Forwarded-For: 10.0.0.1” ca să pară din intranet
        # sau să scape de rate limit; aici antetul conține doar IP-ul văzut de
        # nginx. API-ul are încredere în el numai când vine de la IP-ul fix al
        # acestui container (RateLimit__KnownProxies__0 din docker-compose.yml).
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Real-IP         $remote_addr;

        # Încărcările (până la 51 MB) merg direct spre API, fără copie pe discul
        # proxy-ului. Pe lângă viteză: cifrotextul unui transfer nu rămâne într-un
        # fișier temporar din container.
        proxy_request_buffering off;

        # Descărcarea unui fișier de 50 MB prin /content și exportul jurnalului
        # de audit pot depăși 60 s pe o rețea lentă.
        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        # Fără compresie pe răspunsurile API. Ele combină secrete (tokenuri,
        # chei împachetate) cu date controlate de utilizator (nume de fișier,
        # căutări) - exact condiția atacului BREACH. JSON-ul de aici e mic;
        # câștigul de la gzip nu merită riscul.
        gzip off;

        # Antetele de securitate le pune API-ul (SecurityHeadersMiddleware),
        # inclusiv HSTS: prin X-Forwarded-Proto, cererea e văzută ca HTTPS.
        # Aici NU se adaugă nimic, altfel ar apărea dublate.
    }

    # ── Fișiere statice cu hash în nume ──────────────────────────────────────
    # Vite pune un hash de conținut în numele fiecărui fișier din /assets/.
    # O versiune nouă are alt nume, deci cache-ul poate fi „pentru totdeauna”.
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;

        gzip on;
        gzip_types text/css application/javascript image/svg+xml application/json;
        gzip_min_length 1024;

        try_files $uri =404;
    }

    # Fișierele ascunse (.git, .env) nu există în imagine, dar dacă cineva
    # montează greșit un director peste html/, nu trebuie servite.
    location ~ /\. {
        return 404;
    }

    # ── Aplicația (SPA) ──────────────────────────────────────────────────────
    # Orice rută necunoscută (/transfers, /admin) primește index.html; rutarea
    # o face React Router în browser. index.html nu se păstrează în cache:
    # după o actualizare, utilizatorul trebuie să primească imediat referințele
    # la noile fișiere din /assets/.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;

        gzip on;
        # text/html e comprimat implicit; aici doar celelalte tipuri.
        gzip_types text/css application/javascript image/svg+xml;

        try_files $uri /index.html;
    }
}
