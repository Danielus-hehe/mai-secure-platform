{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "YOUR_DATABASE_CONNECTION_STRING_HERE"
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_HERE",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Encryption": {
    "FileKey": "YOUR_FILE_ENCRYPTION_KEY_HERE"
  },
  "Argon2": {
    "Profiles": {
      "Interactive": {
        "MemorySizeKib": 19456,
        "Iterations": 2,
        "DegreeOfParallelism": 1,
        "SaltSizeBytes": 16,
        "HashSizeBytes": 32
      },
      "Sensitive": {
        "MemorySizeKib": 65536,
        "Iterations": 3,
        "DegreeOfParallelism": 1,
        "SaltSizeBytes": 16,
        "HashSizeBytes": 32
      }
    },
    "DefaultProfile": "Interactive",
    "PrivilegedProfile": "Sensitive",
    "MaxConcurrentHashes": 4,
    "QueueTimeoutSeconds": 10,
    "Pepper": "YOUR_ARGON2_PEPPER_HERE",
    "AllowLegacyPlaintext": true
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "BaseLockoutMinutes": 5,
    "MaxLockoutMinutes": 480,
    "AttemptWindowMinutes": 30
  },
  "RateLimit": {
    "LoginPermitLimit": 10,
    "LoginWindowMinutes": 5,
    "RefreshPermitLimit": 30,
    "RefreshWindowMinutes": 1,
    "PasswordWritePermitLimit": 5,
    "PasswordWriteWindowMinutes": 15,
    "BehindReverseProxy": false,
    "KnownProxies": []
  },
  "PasswordPolicy": {
    "MinLength": 12,
    "MaxLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "ForbidUsernameInPassword": true
  }
}