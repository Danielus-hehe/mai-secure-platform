{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=sgdm;Username=sgdm;Password=SCHIMBA_MA"
  },

  "Jwt": {
    "Key": "GENERATI_CU_openssl_rand_base64_48",
    "Issuer": "SGDM",
    "Audience": "sgdm-frontend"
  },

  "Argon2": {
    "Pepper": "GENERATI_CU_openssl_rand_base64_32",

    "//": "true accepta parole in clar in baza de date. Doar in dezvoltare, doar",
    "//_2": "cat timp mai exista conturi nemigrate. Program.cs opreste pornirea",
    "//_3": "daca ramane true in afara mediului Development.",
    "AllowLegacyPlaintext": false
  },

  "TwoFactor": {
    "//": "Lasat gol in dezvoltare: se deriveaza din Jwt:Key. In productie e obligatoriu",
    "//_2": "si trebuie sa fie un secret SEPARAT — o cheie derivata dintr-un secret",
    "//_3": "partajat inseamna ca scurgerea unuia le compromite pe amandoua.",
    "EncryptionKey": ""
  },

  "Storage": {
    "Provider": "S3",
    "Endpoint": "http://localhost:9000",
    "AccessKey": "sgdm-dev",
    "SecretKey": "SCHIMBA_MA_MINIM_8_CARACTERE",

    "//": "Bucketul creat de minio-init in docker-compose. Trebuie sa coincida cu",
    "//_2": "valoarea STORAGE_BUCKET din .env (sau cu default-ul 'mai-secure').",
    "Bucket": "mai-secure"
  },

  "Smtp": {
    "//": "Optional. Lasat pe valorile-sablon, API-ul porneste fara email (parola",
    "//_2": "temporara la conturile noi). Parola se pune in variabila de mediu",
    "//_3": "MAI_SMTP_PASSWORD sau cu dotnet user-secrets, nu aici.",
    "//_4": "Gmail: smtp.gmail.com, 465, UseSsl true, parola de aplicatie (16 caractere).",
    "Host": "YOUR_SMTP_HOST_HERE",
    "Port": 465,
    "UseSsl": true,
    "From": "YOUR_SMTP_FROM_EMAIL_HERE",
    "DisplayName": "SGDM MAI",
    "Username": "YOUR_SMTP_USERNAME_HERE",
    "Password": "YOUR_SMTP_PASSWORD_HERE"
  },

  "Frontend": {
    "//": "Adresa din linkul de activare trimis pe email.",
    "BaseUrl": "http://localhost:5173"
  },

  "Serilog": {
    "//": "Nivelurile se citesc de aici; sink-ul (consola, JSON) e fixat in Program.cs.",
    "//_2": "Pentru a vedea SQL-ul generat de EF, pune Database.Command pe Information.",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  }
}
