# ============ DEPENDENȚE ============
node_modules/
frontend/node_modules/
frontend/dist/

# ============ BUILD ============
dist/
dist-ssr/
build/
*.local

# ============ VARIABILE DE MEDIU / SECRETE ============
# IMPORTANT: niciodată chei JWT, parole sau configurări sensibile pe GitHub!
.env
.env.*
!.env.example

# ============ LOGURI ============
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============ CACHE / TOOLING ============
.vite/
.eslintcache
*.tsbuildinfo
.oxlintrc-cache/
coverage/

# ============ EDITOR / IDE ============
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sw?

# NOTA: *.sln era ignorat aici. Fisierul de solutie NU e un artefact de editor -
# e ce leaga cele cinci proiecte intre ele. Ignorat, oricine cloneaza repo-ul
# trebuie sa il reconstruiasca manual ca sa poata rula 'dotnet build' pe tot.
# Ce ramane ignorat sunt fisierele de utilizator (*.suo, *.user), de mai jos.

# ============ SISTEM DE OPERARE ============
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
 $RECYCLE.BIN/

# macOS (dacă deschizi proiectul și de pe Mac)
.DS_Store

# ============ Fișiere temporare ============
*.tmp
*.bak
*~

# .NET build output
bin/
obj/
[Bb]in/
[Oo]bj/

# IDE configurations
.vs/
.idea/
*.user

# Secrete locale și configurații de mediu
appsettings.Development.json
appsettings.Production.json
*.env
# ============ SECRETE BACKEND ============
# appsettings.Development.json / .Production.json sunt deja ignorate mai sus.
# Fișierele .example rămân versionate ca șablon - ele NU conțin valori reale.
!**/appsettings.*.json.example
docker-compose.override.yml
MAI.Api/Storage/
migrations/*.local.sql

# Certificate de dezvoltare
*.pfx
*.p12
*.key
!frontend/**/*.key.ts
